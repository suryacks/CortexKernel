{
  "title": "CortexKernel Storage",
  "uid": "cortexkernel-storage",
  "timezone": "browser",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests per second by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (method, path, status) (rate(cortexkernel_http_requests_total[1m]))",
          "legendFormat": "{{method}} {{path}} ({{status}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Average request duration (ms) by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (method, path) (rate(cortexkernel_http_request_duration_ms_sum[1m])) / sum by (method, path) (rate(cortexkernel_http_requests_total[1m]))",
          "legendFormat": "{{method}} {{path}}",
          "refId": "A"
        }
      ]
    }
  ]
}
